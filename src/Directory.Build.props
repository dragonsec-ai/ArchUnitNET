<Project>
  <PropertyGroup>
    <Version Condition="'$(Version)' == ''">3.0.0-beta.1</Version>
    <PackageId>$(MSBuildProjectName)</PackageId>
    <IsPackable>true</IsPackable>
    <Authors>Robey Beswick;ArchUnit.NET contributors</Authors>
    <Description>Architecture tests for C# source: file dependencies, layers, slices, graphs, and metrics.</Description>
    <PackageProjectUrl>https://github.com/dragonsec-ai/ArchUnitNET</PackageProjectUrl>
    <RepositoryUrl>https://github.com/dragonsec-ai/ArchUnitNET</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>architecture;testing;csharp;archunit</PackageTags>
    <!-- The promoted implementation's license is unresolved (#53). Do not infer
         the legacy package's license. Publication requires a reviewed LICENSE. -->
    <PackageLicenseFile Condition="Exists('$(MSBuildThisFileDirectory)../LICENSE')">LICENSE</PackageLicenseFile>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../README.md" Pack="true" PackagePath="/" />
    <None Include="$(MSBuildThisFileDirectory)../LICENSE" Pack="true" PackagePath="/"
          Condition="Exists('$(MSBuildThisFileDirectory)../LICENSE')" />
  </ItemGroup>
</Project>
